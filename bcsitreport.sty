\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bcsitreport}[2026-07-25 BCSIT Report]

% Package Options and Setup
\newif\ifbcsitrep@proposal
\bcsitrep@proposalfalse

\DeclareOption{proposal}{
    % Proposal reports use unnumbered sections
    \setcounter{secnumdepth}{-1}
}
\DeclareOption{project}{
    % Project reports use standard numbered sections
    \setcounter{secnumdepth}{2}
}

\ProcessOptions\relax

% Localization and Document Nomenclature
\RequirePackage[american]{babel}
\addto\captionsamerican{
    \renewcommand{\contentsname}{TABLE OF CONTENTS}
    \renewcommand{\listfigurename}{LIST OF FIGURES}
    \renewcommand{\listtablename}{LIST OF TABLES}
    \renewcommand{\bibname}{REFERENCES}
}

% Page Layout
\RequirePackage[a4paper, left=1.5in, right=1in, top=1in, bottom=1in]{geometry}

% Typography and Line Spacing
\RequirePackage{newtxtext, newtxmath}
\RequirePackage{setspace}
\onehalfspacing

% Paragraph Formatting
\setlength{\parindent}{0pt}
\setlength{\parskip}{1em}

% Heading Styles
\RequirePackage{titlesec}

% Conditional chapter formatting based on document type
\ifbcsitrep@proposal
    \titleformat{\chapter}[block]
        {\normalfont\fontsize{16}{20}\bfseries\filcenter}{}{0em}
        {\MakeUppercase}
\else
    \titleformat{\chapter}[block]
        {\normalfont\fontsize{16}{20}\bfseries\filcenter}
        {\MakeUppercase{\chaptertitlename}\ \thechapter:}{0.3em}
        {\MakeUppercase}
\fi

% Section and Subsection Formatting
\titleformat{\section}
    {\normalfont\fontsize{14}{17}\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}
    {\normalfont\fontsize{12}{14}\bfseries}{\thesubsection}{1em}{}

% Captions and Floating Environments
\RequirePackage{caption}
\captionsetup{
    font={bf, stretch=1.2},
    labelfont=bf,
    textfont=bf,
    justification=centering,
    singlelinecheck=false
}

% Positioning rules for tables and figures
\captionsetup[table]{position=above}
\captionsetup[figure]{position=below}

\RequirePackage{float}
\floatstyle{plaintop}
\restylefloat{table}
\floatstyle{plain}
\restylefloat{figure}

\RequirePackage{graphicx}

% Globally center all floats
\makeatletter
\g@addto@macro\@floatboxreset\centering
\makeatother

% List of Abbreviations Customization
\RequirePackage{enumitem}
\RequirePackage[acronym, nonumberlist]{glossaries}
\makeglossaries

% Neatly align the list of abbreviations
\newglossarystyle{alignedabbreviations}{
    \renewenvironment{theglossary}
        {\begin{description}[leftmargin=2cm, labelwidth=1.5cm, labelsep=0.5cm, align=left]}
        {\end{description}}
    \renewcommand*{\glossaryheader}{}
    \renewcommand*{\glsgroupheading}[1]{}
    \renewcommand{\glossentry}[2]{
        \item[\textbf{\glstarget{##1}{\glossentryname{##1}}}] \glossentrydesc{##1}
    }
}

% Render the list of abbreviations
\newcommand{\listofabbreviations}{
    \setglossarystyle{alignedabbreviations}
    \printglossary[type=\acronymtype, title={LIST OF ABBREVIATIONS}]
}

% TOC Formatting
\RequirePackage{titletoc}
\titlecontents{figure}[0pt]{\addvspace{5pt}}
    {}
    {}
    {\titlerule*[1pc]{.}\contentspage}

\titlecontents{table}[0pt]{\addvspace{5pt}}
    {}
    {}
    {\titlerule*[1pc]{.}\contentspage}

% Bibliography Configuration
\RequirePackage{cite}
\RequirePackage{etoolbox}

% Override default bibliography command to enforce IEEE style and TOC inclusion
\let\oldbibliography\bibliography
\renewcommand{\bibliography}[1]{%
    \bibliographystyle{IEEEtran}%
    \addcontentsline{toc}{chapter}{\bibname}%
    \oldbibliography{#1}%
}

% Document Structure and Pagination
\newcommand{\frontmatter}{
    \clearpage
    \pagenumbering{roman}
}

\newcommand{\frontchapter}[2][]{%
    \clearpage
    \ifstrempty{#1}{}{%
        {\fontsize{12}{14}\selectfont #1\par}
        \vspace{40pt}%
    }%
    {\fontsize{16}{20}\selectfont\bfseries\centering\MakeUppercase{#2}\par}
    \vspace{40pt}%
}

\newcommand{\mainmatter}{
    \clearpage
    \pagenumbering{arabic}
    \setcounter{page}{1}
}

\newcommand{\backmatter}{
    \clearpage
    \appendix
    \setcounter{tocdepth}{0}
}

\pagestyle{plain}

% Hyperlink Configuration
\RequirePackage[hidelinks]{hyperref}
